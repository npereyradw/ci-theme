{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ci/post-body",
	"version": "0.1.0",
	"title": "Post body",
	"category": "ci-template",
	"icon": "text-page",
	"description": "For the single post template: the post text in a reading column and the buttons to share it on LinkedIn, Facebook, WhatsApp or X.",
	"keywords": [ "news", "post", "content", "share" ],
	"textdomain": "ci-theme",
	"attributes": {
		"shareLabel": { "type": "string", "default": "Share" },
		"networks": {
			"type": "array",
			"items": { "type": "string", "enum": [ "linkedin", "facebook", "whatsapp", "x" ] },
			"default": [ "linkedin", "facebook", "whatsapp" ]
		}
	},
	"supports": {
		"html": false,
		"multiple": false,
		"anchor": true
	},
	"example": { "attributes": {} },
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
